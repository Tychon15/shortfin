
font={font} {fontSize}px

width=400
height=160

anchor=bottom-right
outer-margin=0,0,{barMargin},0
margin={barMargin}
padding={padding}
border-radius={radius}
border-size=1
layer=overlay

icon-path=/usr/share/icons/Papirus-Dark
max-icon-size=28
default-timeout=6000
max-visible=4

background-color={bg}
text-color={fg}
border-color={borderPanel}
progress-color=over {accent}

format=%s\n<span foreground="{fgDim}" size="smaller">%b</span>

[grouped]
format=%s <span foreground="{fgDim}" size="smaller">(%g)</span>\n<span foreground="{fgDim}" size="smaller">%b</span>

[urgency=low]
text-color={fgDim}
border-color={borderPanel}
default-timeout=4000

[urgency=critical]
border-color={bad}
default-timeout=0
